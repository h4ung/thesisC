+* ``cox_ph_loss`` — Cox partial likelihood (Breslow ties) for the Cox risk head.
 """
 
 import torch
@@ -55,3 +56,31 @@ def discrete_time_nll(hazard_logits, event_bin, event_indicator):
 
     nll = -(log_surv + log_event)
     return nll.mean()
